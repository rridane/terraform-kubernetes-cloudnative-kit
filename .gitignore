# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Sensitive variable / plan files
*.tfvars
*.tfvars.json
*.tfplan
*tfplan*

# Override files (local overrides, not checked in)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# IDE
.idea/
*.iml
